document.getElementById("supplierTable").addEventListener("click",e=>{
 const b=e.target.closest("[data-delete-supplier]");
 if(!b)return;
 if(confirm("Delete this supplier inventory record?")){
  db.suppliers=db.suppliers.filter(s=>s.id!==b.dataset.deleteSupplier);
  save();render();
 }
});

document.getElementById("orderTable").addEventListener("click",e=>{
 const match=e.target.closest("[data-match]");
 if(match){
  go("matching");
  document.getElementById("matchOrder").value=match.dataset.match;
  document.getElementById("matchQty").value="";
  runMatching();return;
 }
 const del=e.target.closest("[data-delete-order]");
 if(del&&confirm("Delete this buyer order?")){
  db.orders=db.orders.filter(o=>o.id!==del.dataset.deleteOrder);
  save();render();
 }
});

function runMatching(){
 const oid=document.getElementById("matchOrder").value;
 const order=db.orders.find(o=>o.id===oid);
 const out=document.getElementById("matchResult");
 if(!order){out.textContent="Please create a buyer order first.";return;}
 const custom=document.getElementById("matchQty").value;
 const required=custom.trim()===""?Number(order.qty):Number(custom);
 if(!Number.isFinite(required)||required<=0){
  out.textContent="Please enter a valid quantity.";return;
 }
 // Filter verified inventory and sort by ascending unit price.
 const candidates=db.suppliers
  .filter(s=>s.cropId===order.cropId&&s.quality==="Verified"&&Number(s.qty)>0)
  .sort((a,b)=>Number(a.price)-Number(b.price));

 let remaining=required;
 let cost=0;
 const allocations=[];
 for(const s of candidates){
  if(remaining<=0)break;
  const take=Math.min(Number(s.qty),remaining);
  if(take<=0)continue;
  allocations.push({supplier:s,qty:take,cost:take*Number(s.price)});
  remaining=Math.max(0,remaining-take);
  cost+=take*Number(s.price);
 }
 const fulfilled=Math.max(0,required-remaining);
 const percent=Math.min(100,fulfilled/required*100);
 const rows=allocations.map(a=>
 `<tr><td>${esc(a.supplier.name)}</td><td>${esc(a.supplier.location)}</td><td>${qtyText(a.qty,order.cropId)}</td><td>LKR ${fmt(a.supplier.price)}</td><td>LKR ${fmt(a.cost)}</td></tr>`
 ).join("");

 out.innerHTML=`
  <div class="result">
   <h3>${remaining<=0?"✅ Order Can Be Fulfilled":"⚠️ Supply Shortage Detected"}</h3>
   <p><strong>Buyer:</strong> ${esc(order.buyer)} (${esc(order.country)})</p>
   <p><strong>Product:</strong> ${esc(cropName(order.cropId))}</p>
   <p><strong>Required:</strong> ${qtyText(required,order.cropId)}</p>
   <p><strong>Allocated:</strong> ${qtyText(fulfilled,order.cropId)}</p>
   <p><strong>Shortage:</strong> ${qtyText(remaining,order.cropId)}</p>
   <p><strong>Estimated Procurement Cost:</strong> LKR ${fmt(cost)}</p>
   <div class="bar"><div class="fill" style="width:${percent}%"></div></div>
   <p class="muted">${percent.toFixed(1)}% fulfilled</p>
  </div>
  <h3>Suggested Supplier Allocation</h3>
  <div class="tablewrap"><table>
   <thead><tr><th>Supplier</th><th>Location</th><th>Allocated</th><th>Unit Price</th><th>Cost</th></tr></thead>
   <tbody>${rows||'<tr><td colspan="5">No verified stock available.</td></tr>'}</tbody>
  </table></div>
  <p class="muted">Simulation only. No inventory is reserved, no payments are taken, and no orders are submitted.</p>
 `;
}

document.getElementById("matchOrder").addEventListener("change",()=>{
 document.getElementById("matchQty").value="";
 document.getElementById("matchResult").textContent="Click Generate Procurement Plan.";
});

// Initialize all dashboard views.
render();
translate();
</script>
</body>

});

document.getElementById("orderForm").addEventListener("submit",e=>{
 e.preventDefault();
 const q=Number(document.getElementById("orderQty").value);
 if(!(q>0))return alert("Enter valid quantity.");
 db.orders.push({
  id:id(),buyer:document.getElementById("buyerName").value.trim(),
  country:document.getElementById("buyerCountry").value,
